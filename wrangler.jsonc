{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basinmap",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    {
      "pattern": "basinmap.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basinmap-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_BUCKET",
      "bucket_name": "basinmap-public-data"
    },
    {
      "binding": "INTAKE_BUCKET",
      "bucket_name": "basinmap-intake-media"
    }
  ],
  "vars": {
    "PUBLIC_DATA_URL": "https://data.basinmap.org",
    "ENVIRONMENT": "production"
  },
  "env": {
    "development": {
      "vars": {
        "PUBLIC_DATA_URL": "",
        "ENVIRONMENT": "development"
      }
    },
    "staging": {
      "name": "basinmap-staging",
      "routes": [
        {
          "pattern": "staging.basinmap.org",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "basinmap-db-staging",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PUBLIC_BUCKET",
          "bucket_name": "basinmap-public-data-staging"
        },
        {
          "binding": "INTAKE_BUCKET",
          "bucket_name": "basinmap-intake-media-staging"
        }
      ],
      "vars": {
        "PUBLIC_DATA_URL": "/api/r2",
        "ENVIRONMENT": "staging"
      }
    }
  }
}
