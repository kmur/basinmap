{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "basinmap",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "basinmap.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basinmap-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_BUCKET",
      "bucket_name": "basinmap-public-data"
    },
    {
      "binding": "INTAKE_BUCKET",
      "bucket_name": "basinmap-intake-media"
    }
  ],
  "vars": {
    "PUBLIC_DATA_URL": "https://data.basinmap.org",
    "ENVIRONMENT": "production",
    "ORCID_BASE_URL": "https://orcid.org",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGK9Jrv9xidhIizU",
    "DATASET_LICENSE": "CC-BY 4.0",
    "PUBLICATION_BASE_URL": "https://data.basinmap.org",
    "GBIF_API_BASE": "https://api.gbif.org/v1",
    "GBIF_DATASET_KEY": ""
  },
  "triggers": {
    "crons": ["17 10 * * *"]
  },
  "env": {
    "development": {
      "vars": {
        "PUBLIC_DATA_URL": "",
        "ENVIRONMENT": "development",
        "ORCID_BASE_URL": "https://sandbox.orcid.org",
        "TURNSTILE_SITE_KEY": "",
        "DATASET_LICENSE": "CC-BY 4.0",
        "PUBLICATION_BASE_URL": "http://localhost:8787/api/r2",
        "GBIF_API_BASE": "https://api.gbif-uat.org/v1",
        "GBIF_DATASET_KEY": ""
      }
    },
    "staging": {
      "name": "basinmap-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "staging.basinmap.org",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "basinmap-db-staging",
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PUBLIC_BUCKET",
          "bucket_name": "basinmap-public-data-staging"
        },
        {
          "binding": "INTAKE_BUCKET",
          "bucket_name": "basinmap-intake-media-staging"
        }
      ],
      "vars": {
        "PUBLIC_DATA_URL": "/api/r2",
        "ENVIRONMENT": "staging",
        "ORCID_BASE_URL": "https://sandbox.orcid.org",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "DATASET_LICENSE": "CC-BY 4.0",
        "PUBLICATION_BASE_URL": "https://staging.basinmap.org/api/r2",
        "GBIF_API_BASE": "https://api.gbif-uat.org/v1",
        "GBIF_DATASET_KEY": ""
      },
      "triggers": {
        "crons": ["17 10 * * *"]
      }
    }
  }
}
